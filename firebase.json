{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "apphosting": {
    "backendId": "vibefx-v2-web",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".env",
      ".env.*",
      "presets-lightroom",
      "docs",
      "scripts/midjourney-scraper/downloads",
      "functions",
      "render-service",
      "infra",
      "test-fixtures",
      "videotest",
      "vibecut-video-samples",
      ".firebase",
      ".agents",
      ".codex-remote-attachments",
      "tmp-*.png",
      "*.log",
      "test-results",
      "playwright-report",
      "coverage"
    ],
    "alwaysDeployFromSource": true
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": false
  }
}
