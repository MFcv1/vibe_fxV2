rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsUidField() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isUserProfileCreateValid(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'isAnonymous',
          'providers',
          'lastLoginAt',
          'createdAt',
          'updatedAt',
        ]);
    }

    function isUserProfileUpdateValid(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'isAnonymous',
          'providers',
          'lastLoginAt',
          'updatedAt',
        ]);
    }

    function isLibraryFolderValid(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.ownerUid == userId
        && request.resource.data.keys().hasOnly([
          'name',
          'createdAt',
          'updatedAt',
          'source',
          'coverId',
          'ownerUid',
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
    }

    function isLibraryPhotoValid(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.ownerUid == userId
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'folderId',
          'name',
          'bytes',
          'type',
          'width',
          'height',
          'ratio',
          'thumbWidth',
          'thumbHeight',
          'addedAt',
          'takenAt',
          'exif',
          'preset',
          'favorite',
          'previewPath',
          'previewUrl',
          'originalPath',
          'originalUrl',
          'originalSkipped',
          'updatedAt',
        ]);
    }

    function isSoundtrackTrackValid(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.ownerUid == userId
        && request.resource.data.keys().hasOnly([
          'id',
          'ownerUid',
          'title',
          'artist',
          'sourceProvider',
          'provider',
          'sourceName',
          'sourceUrl',
          'sourcePageUrl',
          'license',
          'licenseUrl',
          'attribution',
          'contentIdWarning',
          'rightsStatus',
          'storagePath',
          'downloadUrl',
          'previewUrl',
          'duration',
          'bpm',
          'waveform',
          'tags',
          'category',
          'mood',
          'genre',
          'favorite',
          'archived',
          'commercialUse',
          'socialUse',
          'licenseSnapshotVersion',
          'importedAt',
          'updatedAt',
          'lastUsedAt',
        ]);
    }

    function isSoundtrackPlaylistValid(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.ownerUid == userId
        && request.resource.data.keys().hasOnly([
          'id',
          'ownerUid',
          'name',
          'trackIds',
          'archived',
          'createdAt',
          'updatedAt',
        ]);
    }

    function isUserRightsManifestValid(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.ownerUid == userId
        && request.resource.data.keys().hasOnly([
          'id',
          'ownerUid',
          'userId',
          'exportId',
          'projectId',
          'projectName',
          'exportFormat',
          'sequencePreset',
          'status',
          'trackCount',
          'tracks',
          'blockers',
          'warnings',
          'createdAt',
          'updatedAt',
        ]);
    }

    function isOwnerCreateValid() {
      return signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['metaSync'])
        && (
          !request.resource.data.keys().hasAny(['platformStatus'])
          || request.resource.data.platformStatus == {}
        );
    }

    function isOwnerUpdateValid() {
      return signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'platformStatus',
          'metaSync',
        ]);
    }

    match /users/{userId} {
      allow read: if ownsUserDoc(userId);
      allow create: if isUserProfileCreateValid(userId);
      allow update: if isUserProfileUpdateValid(userId);
      allow delete: if false;

      match /creditLedger/{entryId} {
        allow read: if ownsUserDoc(userId);
        allow write: if false;
      }

      match /soundtrackTracks/{trackId} {
        allow read: if ownsUserDoc(userId);
        allow create, update: if isSoundtrackTrackValid(userId);
        allow delete: if ownsUserDoc(userId);
      }

      match /soundtrackPlaylists/{playlistId} {
        allow read: if ownsUserDoc(userId);
        allow create, update: if isSoundtrackPlaylistValid(userId);
        allow delete: if ownsUserDoc(userId);
      }

      match /rightsManifests/{manifestId} {
        allow read: if ownsUserDoc(userId);
        allow create, update: if isUserRightsManifestValid(userId);
        allow delete: if ownsUserDoc(userId);
      }

      // Bibliotheque photo VibeOS: dossiers d'import et fiches de photos.
      // Donnees strictement personnelles, jamais lisibles par un autre compte.
      // Le quota (nombre de photos et volume) est tenu cote client: ces regles
      // garantissent la propriete, pas le plafond.
      match /libraryFolders/{folderId} {
        allow read: if ownsUserDoc(userId);
        allow create, update: if isLibraryFolderValid(userId);
        allow delete: if ownsUserDoc(userId);
      }

      match /libraryPhotos/{photoId} {
        allow read: if ownsUserDoc(userId);
        allow create, update: if isLibraryPhotoValid(userId);
        allow delete: if ownsUserDoc(userId);
      }
    }

    match /publications/{publicationId} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isOwnerCreateValid();
      allow update: if isOwnerUpdateValid();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /meta_connections/{connectionId} {
      allow read, write: if false;
    }

    match /meta_oauth_states/{stateId} {
      allow read, write: if false;
    }

    match /aiJobs/{jobId} {
      allow read: if ownsUidField();
      allow write: if false;
    }

    match /aiRateLimits/{bucketId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read: if ownsUidField();
      allow write: if false;
    }

    match /checkoutSessions/{sessionId} {
      allow read: if ownsUidField();
      allow write: if false;
    }

    match /accountDeletionRequests/{requestId} {
      allow read, write: if false;
    }

    match /exportJobs/{jobId} {
      allow read: if ownsUidField();
      allow write: if false;
    }

    match /videoExportJobs/{jobId} {
      allow read: if ownsUidField();
      allow write: if false;
    }

    match /rightsManifests/{manifestId} {
      allow read: if ownsUidField();
      allow write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    match /aiPricingPolicies/{policyId} {
      allow read, write: if false;
    }

    match /aiProviderPriceSnapshots/{snapshotId} {
      allow read, write: if false;
    }

    match /providerRegistry/{providerId} {
      allow read, write: if false;
    }

    match /securityEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
