# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/functions/node_modules/
/render-service/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/test-fixtures/vision-corpus/*
!/test-fixtures/vision-corpus/README.md
/public/music/local-imports/*
!/public/music/local-imports/.gitkeep

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log
firestore-debug.log
ui-debug.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.emulators.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reglages Claude Code personnels (permissions gcloud) — non versionnes
.claude/settings.local.json
# Copies de travail creees par les agents : locales a une machine
.claude/worktrees/
presets-lightroom/

# Corpus de reference de `powlisher` : ces photos ne sont pas les notres.
# `node scripts/fetch-powlisher-corpus.mjs` les retelecharge a la demande.
docs/lightroom/corpus-powlisher/*
!docs/lightroom/corpus-powlisher/README.md

# Rendus bruts de l'audit Lightroom : les rapports, metriques et scripts restent
# versionnes, mais les sources et PNG regenerables (plusieurs Go) restent locaux.
docs/lightroom/audit-qualite-presets-2026-08-31/sources/
docs/lightroom/audit-qualite-presets-2026-08-31/lightroom/
docs/lightroom/audit-qualite-presets-2026-08-31/vibefx/
docs/lightroom/audit-qualite-presets-2026-08-31/comparaisons/
docs/lightroom/audit-qualite-presets-2026-08-31/corrections-vintage-bw/comparaisons/
docs/lightroom/audit-qualite-presets-2026-08-31/corrections-vintage-bw/vibefx/
